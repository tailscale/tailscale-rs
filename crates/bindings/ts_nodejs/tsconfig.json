{
  // Type-checks the examples and tests against the built package (`dist/`). Nothing is emitted:
  // they are run directly by Node's type stripping. `tsconfig.build.json` builds `lib/`.
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": false
  },
  "include": ["examples/**/*.ts", "test/**/*.ts"]
}
